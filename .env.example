# Required for the AI features: writing feedback, the speaking examiner, and
# on-demand test generation. Everything else (placement test, study plan,
# reading and listening practice) works without it.
#
# Get a key at https://console.anthropic.com/ then copy this file to .env.local
ANTHROPIC_API_KEY=sk-ant-...

# Optional, owner dashboard only. This is a separate organization Admin API
# key (`sk-ant-admin01-...`), not the key above. Give it the read-only Usage &
# Cost permission. Without it AI features still work; only exact historical
# Anthropic cost totals are unavailable in /admin.
ANTHROPIC_ADMIN_KEY=

# Optional. Set this when the Anthropic organization has other products or
# workspaces, so the dashboard attributes only BandUp's provider costs.
ANTHROPIC_WORKSPACE_ID=


# ---------------------------------------------------------------------------
# Accounts, subscriptions and usage metering
#
# All of this is off unless ACCOUNTS_ENABLED=1. With it unset the app behaves
# exactly as it did before any of it existed: no sign-in, no metering, no
# change to any page. None of the rest of this section needs to be set for the
# app to run.
#
# The one rule that matters here: only variables named NEXT_PUBLIC_* are
# visible to the browser. Everything below is deliberately not, and the service
# role key in particular bypasses every access rule in the database — it is the
# key to the whole thing. If it ever appears in a client bundle, treat it as
# compromised and rotate it in the Supabase dashboard. See ACCOUNTS.md.
# ---------------------------------------------------------------------------

# The master switch. Unset or anything other than 1 means off.
ACCOUNTS_ENABLED=

# Supabase project settings -> API.
# SUPABASE_URL is the project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# The anon/publishable key. Safe to expose in principle, but it is kept
# server-side here because phase 1 has no browser client to give it to.
SUPABASE_ANON_KEY=
# The service_role key. Never expose this, never commit it, never prefix it
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Learner/profile/billing data authority during the Supabase -> Cloudflare
# cutover. supabase (default): Supabase reads/writes only. dual: Supabase stays
# authoritative while learner data is copied to Cloudflare for verification.
# cloudflare: D1/R2 are authoritative for these non-organization records.
CLOUDFLARE_DATA_MODE=supabase

# Required before setting learner data mode to cloudflare. This HMAC key signs
# one-hour avatar delivery grants; R2 remains private and has no public URL.
# Generate independently with:  openssl rand -hex 32
AVATAR_URL_SIGNING_KEY=

# Organization portal, commands, history permissions and normalized attempt
# ledger authority. This has its own safe `supabase` default and deliberately
# does not inherit CLOUDFLARE_DATA_MODE, so organizations can be rehearsed and
# cut over without moving learner progress, profile or billing authority.
# dual: Supabase reads/writes first and copies attempt-ledger writes to D1.
ORGANIZATION_DATA_MODE=supabase

# A random string used to hash client IP addresses before they are stored, so
# the usage table can count requests per address without being a log of who was
# where. Generate one with:  openssl rand -hex 32
# Without it, per-address rate limiting is skipped rather than performed on a
# reversible hash.
USAGE_IP_HASH_SALT=

# What happens when the accounts database cannot be reached: unset (the
# default) refuses AI calls, 1 lets them through. The default protects the API
# budget; 1 protects availability. Pick knowingly.
USAGE_FAIL_OPEN=

# Comma-separated origins allowed to send credentialed cross-origin API
# requests. Empty grants none. The iOS build needs its Capacitor origin here
# before it can send an Authorization header, e.g.
#   ACCOUNTS_ALLOWED_ORIGINS=capacitor://localhost,https://localhost
ACCOUNTS_ALLOWED_ORIGINS=


# ---------------------------------------------------------------------------
# Payments — Stripe, on the web.
#
# All of it is optional and all of it degrades honestly. With none of these
# set, /pricing still renders, still shows both plans and their prices, and
# says plainly that subscriptions are not open yet instead of showing a button
# that fails. Nothing else in the app changes.
#
# Subscriptions also need the accounts section above to be configured: a
# subscription attaches to an account, and there is nowhere to write one
# without a database.
# ---------------------------------------------------------------------------

# Dashboard -> Developers -> API keys. The one that starts sk_.
# Holding this is holding the ability to move money. Never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Dashboard -> Developers -> Webhooks -> your endpoint -> signing secret. The
# whsec_ string, shown once when the endpoint is created.
#
# Without it the webhook refuses every delivery rather than trusting an
# unverified one, which is the only safe behaviour: a webhook that skips the
# signature check is a URL that grants subscriptions to anyone who can POST to
# it. If it is ever rotated in the dashboard, update it here in the same
# minute — deliveries fail silently in between and payments stop being
# recorded.
STRIPE_WEBHOOK_SECRET=

# Turn on the Alipay and WeChat Pay buttons only after both methods show
# Enabled (not Pending approval) in Stripe Dashboard -> Payment methods. The
# server also checks this before creating a wallet Checkout Session.
STRIPE_WALLET_PAYMENTS_ENABLED=

# The Stripe Price ids behind each plan. Dashboard -> Product catalogue.
# These are not secret — a Price id appears in the Checkout URL — but they are
# still read server-side, so that a checkout request names a plan this app
# defined and the server decides what that costs. A request that could name a
# Price could name the one-cent one somebody made while testing.
#
# The amounts in Stripe must match the ones on /pricing, which live in
# lib/billing/tiers.ts. Stripe is what actually charges; the page is only copy.
#
# Today that is three tiers, monthly and yearly:
#
#   Standard  $0.99 / month   $9.99 / year   every practice paper, no AI
#   Plus      $3.49 / month  $34.99 / year   adds AI marking, tutor and lookup
#   Pro       $6.99 / month  $74.99 / year   the same, two to three times over
#
# These are cost-plus: each is what the tier can be made to cost at full usage,
# plus Stripe's cut, plus about HK$3 a month, rounded up. Changing one without
# changing lib/billing/tiers.ts to match means charging an amount the page did
# not say.
#
# A plan with no Price id here is simply not offered; the pricing page says so
# rather than rendering a button that fails on the first click. So it is fine
# to configure Standard alone and add the others later.
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=


# ---------------------------------------------------------------------------
# Apple In-App Purchase (iOS). Not built yet — see ACCOUNTS.md, phase 3.
#
# Apple requires in-app purchase for digital goods, so the App Store build
# cannot use the Stripe checkout above. The database is ready for it: the
# subscriptions table already carries `provider` and an original transaction
# id, and resolve_entitlement does not care which provider granted a tier.
#
# App Store Connect -> Users and Access -> Keys.
# APPLE_IAP_PRIVATE_KEY is the contents of the .p8 file.
# ---------------------------------------------------------------------------
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=


# ---------------------------------------------------------------------------
# Already used by the iOS build (scripts/build-mobile.mjs). Listed for
# completeness: this is the only variable in this file the browser can see, and
# it holds nothing secret — just the URL of the deployed API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=

# ---------------------------------------------------------------------------
# Closing the site from the admin console.
#
# The site closes on NEXT_PUBLIC_MAINTENANCE_MODE, which the deploy workflow
# sets at build time — nothing read at runtime works, because the Cloudflare
# Worker does not have it. So the console's switch records the decision and
# then asks GitHub to run that workflow with the box ticked.
#
# A fine-grained token, this repository only, with Actions: Read and write.
# Nothing else, and never NEXT_PUBLIC_ — it can deploy this site.
#
# Unset, the switch still records the decision and the console says plainly
# that nothing was deployed. Everything else works as normal.
# ---------------------------------------------------------------------------
GITHUB_DEPLOY_TOKEN=

# Which repository to deploy, as owner/name. Only needed on a fork; the code
# defaults to the one this app is deployed from.
GITHUB_REPOSITORY=


# Your own email address, so signing in with it makes you the owner. No SQL.
# Comma-separate for more than one; case and spacing do not matter.
# It grants nothing new — anyone who can set this already holds
# SUPABASE_SERVICE_ROLE_KEY and could write the row by hand. It just puts the
# promotion where the other secrets live.
ADMIN_EMAILS=

# A name to type instead of that address, for the owner only. Resolved to
# ADMIN_EMAILS[0] on the server before the password is checked, so there is no
# second kind of account — it is a shorter thing to type on a phone.
#
# It holds nothing confidential; store it on Cloudflare as a Secret anyway.
# A plain Text variable added in the dashboard is deleted by the next
# `wrangler deploy`, because deploy replaces the Worker's bindings with what is
# in wrangler.jsonc. Secrets survive. See DEPLOY.md.
ADMIN_USERNAME=

# The Google OAuth web client's secret, and the only place Google sign-in in
# the iOS app comes from. Store it on Cloudflare as a Secret.
#
# The website does not read it — its Google button runs the browser flow — so
# leaving this unset breaks sign-in in exactly one place while everything you
# would think to test still passes. /api/auth/google/config answers
# `serverFlow: false`, which is a cue to the client rather than an error, and
# the app then draws "Google sign-in is being updated" where the button
# belongs. It reads as a passing outage rather than a key nobody set.
#
# Its partner, GOOGLE_OAUTH_APP_ORIGIN, lives in wrangler.jsonc and survives a
# deploy. This half cannot, which is why this is the half that goes missing.
# The owner diagnostics check it by name; see DEPLOY.md for the exact command.
GOOGLE_OAUTH_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# Sign in with Apple. None of these is set, and the app is written to be
# perfectly happy about that: with any one of them missing, /api/account/status
# does not offer Apple, no Apple button is drawn anywhere, and every route under
# /api/auth/apple answers 404. Nothing fails, because nothing is offered.
#
# All four need a paid Apple Developer Program membership. There is no free
# tier for Sign in with Apple and no way to exercise the flow without one, so
# the code was written and reviewed but has never met a real Apple response.
#
# THESE ARE NOT THE APPLE_IAP_* VARIABLES ABOVE. Those are an App Store Connect
# API key for in-app purchase: a different key, from a different page, with a
# different issuer, and crossing the two produces a client secret Apple simply
# rejects with no useful explanation. Both sets are .p8 files and both have a
# key id, which is exactly why they are spelled out separately here.
#
# Where each one comes from, in the order you would collect them:
#
#   APPLE_SIGNIN_TEAM_ID       Ten characters, top right of developer.apple.com
#                              once you are a member. Shared with the IAP key's
#                              issuer id in appearance only — they are not the
#                              same value.
#
#   APPLE_SIGNIN_SERVICES_ID   Certificates, Identifiers & Profiles ->
#                              Identifiers -> "+" -> Services IDs. Give it an
#                              identifier such as com.yiuadam.bandup.web, tick
#                              Sign in with Apple, and Configure it: the domain
#                              is bandup.life and the return URL is
#                              https://bandup.life/api/auth/apple/callback,
#                              typed exactly, https, no trailing slash. Apple
#                              refuses a return URL it has not been told about
#                              and refuses localhost outright, so this cannot
#                              be tried on a laptop.
#
#                              It must NOT be the app's bundle id. The bundle id
#                              is the native client and is compiled in; the
#                              Services ID is the website. Both are accepted as
#                              token audiences and they are not interchangeable.
#
#   APPLE_SIGNIN_KEY_ID        Keys -> "+" -> tick Sign in with Apple, choose
#   APPLE_SIGNIN_PRIVATE_KEY   the primary App ID, Register. The ten-character
#                              key id is on the page; the private half
#                              downloads once as AuthKey_XXXXXXXXXX.p8 and
#                              Apple will never send it again. Paste the whole
#                              file including its BEGIN and END lines. Real
#                              newlines and the two-character \n spelling are
#                              both read correctly.
#
# Its partner APPLE_SIGNIN_APP_ORIGIN lives in wrangler.jsonc beside the Google
# one and survives a deploy; these four are secrets and do not.
#
# One more thing has to happen before any of it works, and it is not a variable:
# D1 migration 0022 has to be applied, because until it is, the identity table
# accepts the provider 'google' and nothing else. Applying it rebuilds a live
# identity table and is a production event — see the warning at the top of
# cloudflare/migrations/0022_apple_identity.sql.
# ---------------------------------------------------------------------------
APPLE_SIGNIN_SERVICES_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
