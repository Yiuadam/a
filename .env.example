# Required for the AI features: writing feedback, the speaking examiner, and
# on-demand test generation. Everything else (placement test, study plan,
# reading and listening practice) works without it.
#
# Get a key at https://console.anthropic.com/ then copy this file to .env.local
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Billing (BandUp Plus). See BILLING.md for how these fit together.
#
# Leave the Stripe keys unset and the paywall switches itself off, so a local
# install with only ANTHROPIC_API_KEY behaves exactly as it did before.
# ---------------------------------------------------------------------------

# Secret key from https://dashboard.stripe.com/apikeys — use the test key
# (sk_test_...) everywhere except production.
STRIPE_SECRET_KEY=sk_test_...

# The recurring price learners subscribe to. Create a Product with a recurring
# Price in the dashboard and paste the price id, not the product id.
STRIPE_PRICE_ID=price_...

# The per-seat price schools are invoiced for. May be the same price as above,
# or a discounted one-off price for education.
STRIPE_SEAT_PRICE_ID=price_...

# Signs access tokens. Any long random string; changing it signs every learner
# out. Generate one with:  openssl rand -base64 32
BILLING_TOKEN_SECRET=

# Guards the staff-only invoice endpoint (POST /api/billing/invoice).
# Generate one with:  openssl rand -base64 32
BILLING_ADMIN_SECRET=

# From `stripe listen` locally, or the webhook endpoint's signing secret in the
# dashboard. Without it /api/billing/webhook refuses every request.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional. Absolute URL Stripe returns learners to. Defaults to the origin of
# the request, which is right for localhost and for Vercel previews.
# NEXT_PUBLIC_SITE_URL=https://bandup.life

# Optional. Shown on /pricing. Left unset, the page says "Price shown at
# checkout" rather than displaying a figure that might not match Stripe.
# NEXT_PUBLIC_PLUS_PRICE_LABEL=£9/month

# Optional. Free-trial length in days for new subscriptions. Unset means none.
# STRIPE_TRIAL_DAYS=7

# Optional. Set to 1 only once Stripe Tax is configured on the account —
# Checkout fails outright if it is switched on without an origin address.
# STRIPE_AUTOMATIC_TAX=1

# Optional. Force the paywall on (1) or off (0). Unset means "on when the
# Stripe key and the token secret are both present", which is what you want
# almost always. Set it to 1 in production if you would rather a missing key
# locked the AI features than gave them away.
# BILLING_ENFORCED=1
