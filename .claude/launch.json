{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bandup-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "bandup-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "--port",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "bandup-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--local",
        "--port",
        "8793",
        "--inspector-port",
        "8794"
      ],
      "port": 8793
    }
  ]
}